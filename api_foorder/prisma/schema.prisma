// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

enum OrderStatus {
  PREPARATION
  READY
  GIVEN
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}


model User {
  user_id     Int         @id   @default(autoincrement())
  username    String      @unique
  password    String
}

model Orders {
  order_id    Int         @id   @default(autoincrement())
  name        String?
  status      OrderStatus
  order_hour  DateTime
  ready_hour  DateTime?

  products    ProductOrderRelation[]
}

model Products {
  product_id  Int        @id  @default(autoincrement())
  name        String
  price       Float

  orders   ProductOrderRelation[]
}

model Ingredients {
  ingredient_id   Int    @id   @default(autoincrement())
  name            String
  stock           Int
}

model ProductOrderRelation {
  relation_id   Int       @id   @default(autoincrement())
  
  order         Orders    @relation(fields: [order_id], references: [order_id])
  order_id      Int

  product       Products  @relation(fields: [product_id], references: [product_id])
  product_id    Int

  quantite      Int
}